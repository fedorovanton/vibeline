# секреты
.env
*.key
*.pem
# Исключение: открытые корневые сертификаты Минцифры, которыми подписан
# alfagen.alfabank.ru. Приватных ключей в них нет, а без них обращение к
# модели из контейнера отказывает на проверке сертификата.
!deploy/certs/*.pem

# сборка
/bin/
/dist/
# Собранный бинарник в корне. Ведущий слеш обязателен: без него шаблон
# совпадал с каталогом cmd/ai-gateway/ и прятал точку входа сервиса
# от контроля версий целиком.
/ai-gateway
# Собранный бинарник нагрузочного теста рядом с его исходниками.
/tools/loadtest/loadtest

# артефакты прогонов
/reports/
*.prof
*.test

# ОС и IDE
.DS_Store
.idea/
.vscode/

# корпуса и отчёты прогонов — генерируются по требованию
/testdata/
corpus*.jsonl
*.jsonl

# рабочие артефакты навыков: отчёты жюри и аудитов перезаписываются
# при каждом прогоне, версионировать их нечего
/.agents/runtime/

# рабочие каталоги агентов и инструментов разработки — не часть решения
.claude/
.agents/
# исходные PDF организаторов в публичный репозиторий не выкладываются
/docs/pdf/
