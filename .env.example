# Ключ доступа к модели AlfaGen.
# Брать на портале https://alfagen.alfabank.ru/plugins, раздел Enterprise Vibe Coding.
# Без префикса Bearer.
ALFAGEN_API_KEY=<вставить ключ>

# Ключи систем-потребителей. Заданная переменная перекрывает значение
# из config.yaml. Для демонстрации достаточно значения из конфигурации.
# DEMO_API_KEY=
# CRM_API_KEY=
# ANALYTICS_API_KEY=

# Ключ токенизации для стратегии token (HMAC-SHA256). Без него ключ случайный
# на процесс: токены стабильны до перезапуска. Задайте, если токены должны
# совпадать между перезапусками и экземплярами.
# AIGW_TOKEN_KEY=
