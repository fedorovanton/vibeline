# Пример файла окружения для AlfaGen.
# Скопируйте в корень репозитория как .env и вставьте реальный ключ:
#   cp specs/api-alfagen/.env.example .env
#
# Это основной способ хранения ключа: решение читает .env автоматически,
# поэтому работает на любом ПК без глобальных переменных окружения.
#
# Ключ берётся на портале https://alfagen.alfabank.ru/
# (раздел «Enterprise Vibe Coding»). Без префикса "Bearer".
#
# ⚠️ Файл .env игнорируется git — не коммитьте реальный ключ.

ALFAGEN_API_KEY=your-alfagen-api-key-here

# Опционально (если не заданы — используются дефолты):
# ALFAGEN_BASE_URL=https://alfagen.alfabank.ru/continue-dev/v1
# ALFAGEN_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731